# Kopie davon als scripts/deploy.conf speichern. deploy.conf kommt NICHT ins Git.
# MODE: rsync (SSH) oder lftp (SFTP)
MODE=rsync
REMOTE_HOST=w0183590.kasserver.com
REMOTE_USER=ssh-w0183590                        # SSH-Login des Hauptaccounts (KAS: Tools -> SSH-Zugang)
REMOTE_DIR=/www/htdocs/w0183590/notfall.xatmotion/   # Ziel von xatmotion.de laut KAS (Mit Schrägstrich am Ende)
SITE_URL=https://www.xatmotion.de
# Optional: eigener SSH-Schlüssel (empfohlen, mit Passphrase). Ohne Zeile fragt ssh nach dem Passwort.
# SSH_KEY=$HOME/.ssh/id_ed25519_allinkl
# Optional: Zielordner lokal für Tests (lädt nichts hoch)
# LOCAL_TARGET=/tmp/xatmotion-testziel/
